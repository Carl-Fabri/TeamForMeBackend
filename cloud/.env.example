# Copiar a .env para docker compose. NUNCA subir .env al repositorio.
# En Azure estos valores viven en Key Vault (secretos Internal--ApiKey y grafana-admin-password).
INTERNAL_API_KEY=dev-internal-key-change-me
GRAFANA_ADMIN_PASSWORD=admin
# Opcional: probar Key Vault real desde local (requiere `az login`).
KEYVAULT_URI=
# Solo en la VM de Azure: client id de la identidad administrada id-teamforme.
AZURE_CLIENT_ID=
# Puertos del host (cámbialos si ya están ocupados en tu equipo).
GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
